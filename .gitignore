# =============================================================
#  Vivado Project .gitignore
# =============================================================

# --- 1. Vivado Internal "Junk" Folders ---
.Xil/
*.cache/
*.runs/
*.sim/
*.ip_user_files/
*.hw/
*.sdk/

# --- 2. Simulation Files (CRITICAL) ---
*.vcd
*.wdb
*.wcfg.bak
xsim.dir/
*.pb

# --- 3. Log and Journal Files ---
*.jou
*.log
*.str
*.rpt
webtalk*
hs_err_pid*

# --- 4. Output Binary Files ---
*.bit
*.bin
*.dcp
*.mcs

# --- 5. OS and Editor Files ---
.DS_Store
.vscode/
*.swp

# =============================================================
#  NOTES:
#  1. This keeps '*.srcs/' (Your Code)
#  2. This keeps '*.xpr' (Your Project Settings)
#  3. This keeps '*.coe' (Your Instruction Memory)
# =============================================================